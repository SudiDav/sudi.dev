              "name": "Article Title",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Building a Real-Time Collaboration Engine from Scratch",
              "lineHeight": 1.2,
              "textAlign": "center",
              "fontFamily": "Geist",
              "fontSize": 42,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "ZBNwN",
