            {
              "type": "frame",
              "id": "tvYg1",
              "name": "Author Bio Card",
              "width": "fill_container",
              "fill": "$bg-card",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "gap": 20,
              "padding": 24,
              "alignItems": "center",
              "children": [
                {
                  "type": "ellipse",
                  "id": "uNmqb",
                  "name": "Author Avatar",
                  "fill": {
                    "type": "image",
                    "enabled": true,
                    "url": "images/generated-1785843188805.png",
                    "mode": "fill"
                  },
                  "width": 64,
                  "height": 64
                },
                {
                  "type": "frame",
                  "id": "McNXh",
                  "name": "Bio Content",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "r5fMhU",
                      "name": "Written By",
                      "fill": "$text-tertiary",
                      "content": "WRITTEN BY",
                      "fontFamily": "Geist Mono",
                      "fontSize": 11,
                      "fontWeight": "normal",
                      "letterSpacing": 2
