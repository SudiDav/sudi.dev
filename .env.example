# Docker Compose configuration. Copy to .env; never commit actual secrets.
# Generate passwords/secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REVALIDATION_SECRET=
SITE_URL=http://localhost:3000
ADMIN_EMAIL=you@example.com

# GitHub OAuth app. Callback URL:
# http://localhost:3000/api/backend/auth/callback/github
# Production: https://sudi.dev/api/backend/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend. Publishing creates a draft; an admin explicitly sends it.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM=contact@sudi.dev
CONTACT_EMAIL=contact@sudi.dev

# Read-only GitHub integration for comment administration (not publishing).
GITHUB_TOKEN=
GITHUB_REPO=SudiDav/sudi.dev
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Inlined at frontend build time.
NEXT_PUBLIC_GISCUS_REPO=SudiDav/sudi.dev
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
