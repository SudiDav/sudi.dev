# ── Admin sign-in ────────────────────────────────────────────────────────────
# The ONLY Google account allowed into /admin. Anyone else is rejected before a
# session is issued.
ADMIN_EMAIL=you@gmail.com

# From GitHub → Settings → Developer settings → OAuth Apps → APIs & Services → Credentials → OAuth client ID
# (application type: Web application).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/github
#   https://your-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Signs the session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ── Publishing ───────────────────────────────────────────────────────────────
# A fine-grained GitHub token with Contents: read & write on THIS repo only.
# The admin commits MDX here, which triggers a redeploy.
GITHUB_TOKEN=
GITHUB_REPO=SudiDav/sudi.dev
GITHUB_BRANCH=main

# Optional: lets the admin show the live Vercel deployment status after a save.
# Create a Vercel token with deployment read access and use the project ID from
# Vercel → Project Settings → General.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_your_project_id

# Local development only: skips Google sign-in entirely.
# Ignored unless NODE_ENV is not production. Never set this on a deployed site.
AUTH_DEV_BYPASS=false

# Newsletter notifications. RESEND_API_KEY and RESEND_AUDIENCE_ID are required
# to save subscriptions. CONTACT_EMAIL is only needed for the owner notice.
#   1. Create a free account at https://resend.com
#   2. Copy an API key from the dashboard into RESEND_API_KEY
#   3. Verify your domain, then set EMAIL_FROM to an address on it
# Until a domain is verified, Resend only delivers to your own account address,
# and EMAIL_FROM must stay onboarding@resend.dev.
RESEND_API_KEY=
CONTACT_EMAIL=contact@sudi.dev
EMAIL_FROM=sudi.dev <onboarding@resend.dev>

# Comments, via GitHub Discussions (https://giscus.app).
# The repo must be public, have Discussions enabled, and have the giscus app
# installed. giscus.app generates these four values for you.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Newsletter list. Create an audience in the Resend dashboard and paste its id.
# The free plan holds 1,000 contacts.
RESEND_AUDIENCE_ID=
