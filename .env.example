# ── Admin sign-in ────────────────────────────────────────────────────────────
# The only account allowed into /admin. Readers may still sign in to comment,
# but admin access always requires an exact email match.
ADMIN_EMAIL=you@gmail.com

# From GitHub → Settings → Developer settings → OAuth Apps.
# The callback URL must be:
#   http://localhost:3000/api/auth/callback/github
#   https://your-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# From Google Cloud → APIs & Services → Credentials → OAuth client ID
# (application type: Web application). Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signs the session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# ── Reader comments ─────────────────────────────────────────────────────────
# Neon Postgres connection string. Apply db/migrations/0001_comments.sql before
# enabling comments. Vercel's Neon integration can provide DATABASE_URL.
DATABASE_URL=

# Keyed, non-reversible actor identifiers are used for comment throttling.
# Generate with:  openssl rand -base64 32
COMMENT_HMAC_SECRET=

# ── Publishing ───────────────────────────────────────────────────────────────
# A fine-grained GitHub token with Contents: read & write on THIS repo only.
# The admin commits MDX here, which triggers a redeploy.
GITHUB_TOKEN=
GITHUB_REPO=SudiDav/sudi.dev
GITHUB_BRANCH=main

# Optional: lets the admin show the live Vercel deployment status after a save.
# Create a Vercel token with deployment read access and use the project ID from
# Vercel → Project Settings → General.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_your_project_id

# Local development only: skips Google sign-in entirely.
# Ignored unless NODE_ENV is not production. Never set this on a deployed site.
AUTH_DEV_BYPASS=false

# Newsletter notifications and broadcasts. RESEND_API_KEY and
# RESEND_AUDIENCE_ID are required to save subscriptions and prepare post
# announcement drafts. CONTACT_EMAIL is only needed for the owner notice.
#   1. Create a free account at https://resend.com
#   2. Copy an API key from the dashboard into RESEND_API_KEY
#   3. Verify your domain, then set EMAIL_FROM to an address on it
# Publishing creates a draft only. An admin sends it from Admin → Newsletters.
RESEND_API_KEY=
CONTACT_EMAIL=contact@sudi.dev
EMAIL_FROM=contact@sudi.dev

# Newsletter list. Create an audience in the Resend dashboard and paste its id.
# The free plan holds 1,000 contacts.
RESEND_AUDIENCE_ID=
